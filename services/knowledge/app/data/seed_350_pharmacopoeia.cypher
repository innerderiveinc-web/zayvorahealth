MERGE (m:Mufrad {id: 'ZMF-226'}) SET m.name = 'Tukhm-e-Hayat', m.botanicalName = 'Lepidium sativum L.', m.partUsed = 'Dried ripe seeds (Tukhm-e-Hayat)', m.isScheduleE1 = false, m.dose = '2g to 5g with warm milk, jaggery or honey.';
