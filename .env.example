# ============================================================
#  ZAYVORA Health OS™ — Environment Configuration
#  Copy to .env and fill in real values
#  Status: Pre-staging / Pilot Candidate
#  ⚠  Never commit .env to version control
# ============================================================

# ── Environment ─────────────────────────────────────────────
ENVIRONMENT=development
# Options: development | staging | production
# In production, provision.py requires --yes-i-know-this-is-live

# ── Database ────────────────────────────────────────────────
# SQLite (development — no PostgreSQL required)
SQLITE_PATH=./database/zayvora_live.db

# PostgreSQL (staging / production)
DATABASE_URL=postgresql://zayvora:zayvora@localhost:5432/zayvora

# Per-service database URLs (override DATABASE_URL if needed)
IDENTITY_DATABASE_URL=postgresql://zayvora:zayvora@localhost:5432/zayvora_identity
CLINICAL_DATABASE_URL=postgresql://zayvora:zayvora@localhost:5432/zayvora_clinical
KNOWLEDGE_DATABASE_URL=postgresql://zayvora:zayvora@localhost:5432/zayvora_knowledge
THERAPEUTIC_DATABASE_URL=postgresql://zayvora:zayvora@localhost:5432/zayvora_therapeutic
AI_DATABASE_URL=postgresql://zayvora:zayvora@localhost:5432/zayvora_ai

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Identity / Auth ─────────────────────────────────────────
# Generate RS256 keypair:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_REQUIRED=true
SESSION_TIMEOUT_MINUTES=15

# 21 CFR Part 11 HMAC key (min 32 bytes, use secrets.token_hex(32))
CFR_HMAC_SECRET=CHANGE_ME_use_secrets_token_hex_32

# ── AI / Hakeem Sahab AI™ ───────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=optional_openai_fallback_key
AI_MODEL=gemini-1.5-pro
HAKEEM_SAHAB_SAFE_TO_LOCK=false
# safe_to_lock MUST remain false — AI output always requires clinician sign-off

# ── Service Ports ───────────────────────────────────────────
GATEWAY_PORT=8000
IDENTITY_PORT=8001
CLINICAL_PORT=8002
KNOWLEDGE_PORT=8003
THERAPEUTIC_PORT=8004
AI_PORT=8005

# ── Secrets / Vault ─────────────────────────────────────────
# HashiCorp Vault (production — not yet live)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=CHANGE_ME
VAULT_NAMESPACE=zayvora

# ── Neo4j — ZAYVORA Knowledge Base (ZKB) ────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# ── Email / Notifications ────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@zayvora.health
SMTP_PASSWORD=CHANGE_ME
FROM_EMAIL=ZAYVORA Health OS™ <notifications@zayvora.health>

# ── CORS / Frontend ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Feature Flags ───────────────────────────────────────────
FEATURE_TELECONSULT=false
FEATURE_PAYMENT_GATEWAY=false
FEATURE_NEO4J_ZKB=false
FEATURE_VAULT=false

# ── ZFIE Initial Deployment Feature Flags (Section 68) ────────
ZFIE_ENABLED=true
ZFIE_RESEARCH_ENABLED=true
ZFIE_SHADOW_MODE=true
ZFIE_CLINICAL_CDS_ENABLED=false
ZFIE_SYNERGY_ENABLED=false
ZFIE_BIOLOGICAL_STATE_ENABLED=false
ZFIE_EXPERIMENT_PLANNER_ENABLED=false

# ── Monitoring ──────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL=INFO

# ── Schedule E(1) Safety Gate ────────────────────────────────
SCHEDULE_E1_GATE_ENABLED=true
MUDABBAR_CERT_REQUIRED=true

# ── GDPR ────────────────────────────────────────────────────
GDPR_EXPORT_RETENTION_DAYS=30
GDPR_ERASURE_GRACE_HOURS=72
